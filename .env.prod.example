# ============================================
# Configuration Production - Projet FSAC
# ============================================
# 1. Copiez ce fichier : cp .env.prod.example .env.prod
# 2. Remplissez toutes les valeurs
# 3. Lancez : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ============================================

# Clé secrète Flask (OBLIGATOIRE - générez avec : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=changez-moi-par-une-cle-tres-longue-et-aleatoire-64-caracteres-minimum

# Environnement
FLASK_ENV=production

# Base de données MySQL
MYSQL_PASSWORD=changez-moi-mot-de-passe-fort
MYSQL_DB=Fsac

# Admin par défaut (créé automatiquement au premier démarrage)
ADMIN_EMAIL=admin@fsac.ma
ADMIN_PASSWORD=Admin123!
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=System

# SMTP (notifications email)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-app
MAIL_FROM=noreply@fsac.ma

# ============================================
# SSL / HTTPS
# ============================================
# Pour Let's Encrypt (production avec un vrai domaine) :
#   1. Assurez-vous que votre domaine pointe vers ce serveur
#   2. Lancez : docker compose -f docker-compose.prod.yml run certbot certonly
#              --webroot --webroot-path=/var/www/certbot -d votre-domaine.ma
#   3. Les certificats seront dans nginx/ssl/live/votre-domaine.ma/
#
# Pour un certificat auto-signé (développement/test) :
#   bash nginx/generate_ssl_dev.sh
# ============================================
DOMAIN=localhost
